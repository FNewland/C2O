# Cloud simulator VM: template for sim/docker/space.env on Google Cloud.
# vm-bootstrap.sh renders it on every boot (@GROUND_IP@ = c2o-ground-ip
# metadata) and appends SMO_LINK_SESSION/SECRET from Secret Manager.
# Do not put credentials here; this file is committed.
# Generic reference for all keys: sim/docker/space.env.example.

# The ground VM's PRIVATE address, plaintext ws:// inside the VPC. The agent
# accepts ws:// only to a loopback / RFC 1918 / ULA IP literal (checked in
# smo_link/channel.py host_is_private); frames are MACed end to end. Never
# use ws:// with a host name, and do not set SMO_LINK_ALLOW_INSECURE.
SMO_LINK_URL=ws://@GROUND_IP@:9100/link

# complete = replay TM after a reconnect (default); timely = live TM only
SMO_LINK_MODE=complete
SMO_UI=modern
