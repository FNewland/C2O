# Ground VM: template for sim/docker/ground.env on Google Cloud.
# vm-bootstrap.sh renders it on every boot: @MY_IP@ = this VM's internal IP,
# @DOMAIN@ = c2o-domain metadata, then appends SMO_LINK_SESSION/SECRET from
# Secret Manager. Do not put credentials here; this file is committed.
# Generic reference for all keys: sim/docker/ground.env.example.

# Publish MCS 9090, planner 9091, instructor proxy 8080, link 9100 and the
# tool viewers 8092-8095 on the VM's INTERNAL address. The VPC firewall admits only the Google LB ranges
# (and, on 9100, the cloud simulator VM). compose reads this for its
# `ports:` lines only via `docker compose --env-file docker/ground.env`.
SMO_PUBLISH_ADDR=@MY_IP@

# The instructor console is served at https://sim.<domain> through the GSG
# proxy; its Host and Origin are accepted only for this name.
SMO_GSG_ALLOWED_ORIGINS=https://sim.@DOMAIN@

# MCS upstream: the GSG directly (8002/8001). The RF bridge (started by
# vm-bootstrap.sh with `--profile ground --profile rf`) runs as a TAP beside
# it and serves the radio view at https://radio.<domain>. Do not route the MCS
# through the bridge (8012/8011) for classes: the bridge models the S-band
# link only, so the UHF beacon telemetry of LEOP never reaches the MCS.
SMO_MCS_TM_PORT=8002
SMO_MCS_TC_PORT=8001
SMO_RF_MODE=FRAME

# sim = follow the simulator clock (re-timed by the GSG)
SMO_TIME_SOURCE=sim
SMO_LINK_TC_TTL_S=5
SMO_UI=modern
