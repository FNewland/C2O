# Laptop simulator with Docker (alternative to `SMO_PROFILE=space ./start.sh`).
#   cp deploy/gcp/env/space.env.laptop.example sim/docker/space.env
#   then append the two lines of session.env (README step 9) and run, from sim/:
#   SMO_CONFIG_HASH=$(docker/config-hash.sh) \
#     docker compose --env-file docker/space.env -f docker/compose.yaml --profile space up -d --build
SMO_LINK_URL=wss://link.c2o.live/link
SMO_LINK_MODE=complete
# SMO_LINK_SESSION=   <- from session.env
# SMO_LINK_SECRET=    <- from session.env
