# C2O on Google Cloud: settings for setup.sh, start.sh, stop.sh,
# rotate-link-secret.sh and teardown.sh.
#
#   cp deploy/gcp/c2o.env.example deploy/gcp/c2o.env     # then edit PROJECT
#
# deploy/gcp/c2o.env is git-ignored. It holds no secrets, only names.

# ── Must set ────────────────────────────────────────────────────────────
# The project you created inside the c2o.live organisation (README step 4).
# Project IDs are global and permanent: 6-30 chars, lowercase, digits, hyphens.
PROJECT=c2o-live-prod

# ── Decided (change only with a reason) ─────────────────────────────────
REGION=northamerica-northeast2          # Toronto
ZONE=northamerica-northeast2-a
DOMAIN=c2o.live
INSTRUCTORS_GROUP=c2o-instructors@c2o.live
STUDENTS_GROUP=c2o-students@c2o.live

# Also put the bare domain (c2o.live) on the certificate and send it to the
# MCS until the portal exists. "yes" means you MUST also add the apex A
# record (README step 6), or the certificate never finishes provisioning.
INCLUDE_APEX=yes

# Which simulator start.sh brings up by default: "cloud" (the sim VM) or
# "laptop" (your own machine runs SMO_PROFILE=space). Override per run:
#   ./start.sh --sim=laptop
SIM_MODE=cloud

# The radio view's RF bridge on the ground VM (https://radio.<domain>):
#   FRAME = CCSDS frames through a channel model (light; the default)
#   RF    = full baseband: modulation, IQ, constellation, spectrum, eye
#           (much heavier on the CPU; pure-Python demodulator)
# After changing it: rerun setup.sh, then on the ground VM
#   sudo bash /opt/c2o/deploy/gcp/vm-bootstrap.sh refresh
RF_MODE=FRAME

# ── Code ────────────────────────────────────────────────────────────────
# Both VMs clone this on first boot. deploy/gcp/ must be pushed to it.
REPO_URL=https://github.com/FNewland/C2O.git
REPO_REF=main

# ── Sizing and addressing (defaults are fine) ───────────────────────────
GROUND_MACHINE_TYPE=e2-standard-2
SIM_MACHINE_TYPE=e2-standard-2
BOOT_DISK_GB=30
SUBNET_RANGE=10.20.0.0/24
GROUND_IP=10.20.0.10                    # the sim VM dials ws://GROUND_IP:9100/link
SIM_IP=10.20.0.11
CREATE_SIM_VM=yes                       # "no" if you will only ever use the laptop

# Cloud Armor per-client-IP limits, requests per minute.
# A whole class behind one campus NAT address shares the UI budget, so it is
# generous. Lower it once you have seen a real class in the logs.
UI_RATE_PER_MIN=6000
LINK_RATE_PER_MIN=30                    # /link upgrades; the agent reconnects a few times a minute at most

# Name prefix for every resource the scripts create.
PREFIX=c2o
