#!/usr/bin/env bash
# c2o: one command to run the C2O deployment on Google Cloud.
#
#   c2o help                  overview of every command
#   c2o status                what is running, what is up, what it costs now
#   c2o up / c2o down         class on / class off
#   c2o schedule ...          start and stop the VMs automatically
#   c2o data ...              recordings: sizes, clean-up, disk snapshots
#   c2o users ...             student and instructor accounts (@DOMAIN)
#
# Install once (macOS zsh or bash; Cloud Shell bash), then open a new terminal:
#   echo "alias c2o='bash ~/C2O/deploy/gcp/c2o'" >> ~/.zshrc     # macOS
#   echo "alias c2o='bash ~/C2O/deploy/gcp/c2o'" >> ~/.bashrc    # Cloud Shell
#
# It calls the scripts beside it (start.sh, stop.sh, vm-bootstrap.sh) and
# reads c2o.env. Runs under macOS bash 3.2 and Linux bash: no associative
# arrays, no GNU-only flags.
set -euo pipefail

C2O_DIR="$(cd "$(dirname "$0")" && pwd)"
ASSUME_YES=no

# ── Prices (README §12, list prices retrieved 2026-10-30; rough) ─────────
USD_CAD=1.39                 # assumed exchange rate
VM_USD_H=0.0738              # e2-standard-2, Toronto
DISK_USD_GB_MONTH=0.11       # balanced persistent disk
FR_USD_H=0.025               # the two LB forwarding rules (first-5 bundle)
IP_IDLE_USD_H=0.01           # reserved LB IP while no forwarding rule uses it
ARMOR_USD_MONTH=7            # Cloud Armor policy + 2 rules
NAT_IP_USD_H=0.005           # Cloud NAT address
NAT_VM_USD_H=0.0014          # Cloud NAT, per running VM
SNAP_USD_GB_MONTH=0.05       # standard snapshot storage [verify]
VOICE_VM_USD_H=0.0184        # e2-small, Toronto (voice loops VM)
VOICE_IP_USD_H=0.005         # its static IPv4 while the VM runs
VOICE_IP_IDLE_USD_H=0.01     # ... and while it is stopped (reserved, unused)

ADMIN_API=https://admin.googleapis.com/admin/directory/v1
ADMIN_SCOPES=https://www.googleapis.com/auth/admin.directory.user,https://www.googleapis.com/auth/admin.directory.group.member,https://www.googleapis.com/auth/cloud-platform

