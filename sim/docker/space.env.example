# Space side (simulator + space-link agent). Copy to docker/space.env.
# Keys: docs/web_2026-10/LINK_DESIGN.md §4. Never commit the filled-in file.

# GSG link endpoint. wss:// through the load balancer. The agent refuses
# plaintext ws:// unless the host is a loopback / RFC 1918 / IPv6 ULA address
# literal; SMO_LINK_ALLOW_INSECURE=1 overrides that (logged as a warning).
# Laptop: wss://link.c2o.live/link. Cloud sim VM: ws://<ground private IP>:9100/link.
# Run compose with --env-file docker/space.env (see compose.yaml header).
SMO_LINK_URL=wss://link.c2o.live/link

# Session id and 32-byte hex secret, issued on the ground with
#   python -m smo_link.token new
# Give the ground (docker/ground.env) the SAME pair.
SMO_LINK_SESSION=
SMO_LINK_SECRET=
# ...or mount a file and point at it instead of SMO_LINK_SECRET:
# SMO_LINK_SECRET_FILE=/run/secrets/smo_link_secret

# complete = replay TM after a reconnect (default); timely = live TM only
SMO_LINK_MODE=complete

# Optional
# SMO_UI=modern
# SMO_LANG=en
