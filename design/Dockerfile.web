# ============================================================================
# SpaceCDF: hosted image (backend + built frontend in one container)
# ============================================================================
# Used by the C2O cloud deployment (sim/docker/compose.yaml, profile
# "design", served at https://design.<domain> behind Google IAP).
# The development setup (Dockerfile + docker-compose.yml, Vite dev server)
# is unchanged.
#
#   docker build -f Dockerfile.web -t spacecdf-web .        (from design/)
#   docker run -p 8000:8000 -v spacecdf-data:/data spacecdf-web
# ============================================================================

# ── 1. Frontend ─────────────────────────────────────────────────────────────
FROM node:22-slim AS frontend
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ── 2. Backend ──────────────────────────────────────────────────────────────
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SPACECDF_STATIC_DIR=/app/frontend/dist \
    DATABASE_URL=sqlite+aiosqlite:////data/spacecdf.db \
    SPACECDF_DATA_DIR=/data

WORKDIR /app
RUN groupadd --system --gid 10002 spacecdf \
 && useradd --system --uid 10002 --gid spacecdf --home /app spacecdf \
 && mkdir -p /data && chown spacecdf:spacecdf /data

COPY pyproject.toml ./
COPY packages/ packages/
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir \
        -e packages/spacecdf-common \
        -e packages/spacecdf-kb \
        -e packages/spacecdf-agents \
        -e packages/spacecdf-ai \
        -e packages/spacecdf-server

COPY configs/ configs/
COPY --from=frontend /src/dist/ frontend/dist/

USER spacecdf
VOLUME ["/data"]
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4); sys.exit(0)"
CMD ["uvicorn", "spacecdf_server.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
