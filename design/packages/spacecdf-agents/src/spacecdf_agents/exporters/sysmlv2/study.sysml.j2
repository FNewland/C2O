// SysML v2 textual model generated by SpaceCDF (SCDF-160) — study {{ study_id }}
package {{ package }} {
    doc /* {{ study_name or study_id }} — exported by SpaceCDF */

    // ── part definitions (one per element type) ──
{% for d in part_defs %}
    part def {{ d }};
{% endfor %}
{% macro part(p, indent) %}
{% if p.attributes or p.children or p.description %}
{{ indent }}part {{ p.name }} : {{ p.type }} {
{% if p.description %}
{{ indent }}    doc /* {{ p.description }} */
{% endif %}
{% for a in p.attributes %}
{{ indent }}    attribute {{ a.name }} = {{ a.value }};{% if a.unit %}  // unit: {{ a.unit }}{% endif +%}
{% endfor %}
{% for c in p.children %}
{{ part(c, indent ~ "    ") -}}
{% endfor %}
{{ indent }}}
{% else %}
{{ indent }}part {{ p.name }} : {{ p.type }};
{% endif %}
{% endmacro %}
{% macro action_def(f) %}
    action def {{ f.def }};
{% for c in f.children %}
{{ action_def(c) -}}
{% endfor %}
{% endmacro %}
{% macro action(f, indent) %}
{% if f.children or f.description %}
{{ indent }}action {{ f.name }} : {{ f.def }} {
{% if f.description %}
{{ indent }}    doc /* {{ f.description }} */
{% endif %}
{% for c in f.children %}
{{ action(c, indent ~ "    ") -}}
{% endfor %}
{{ indent }}}
{% else %}
{{ indent }}action {{ f.name }} : {{ f.def }};  // layer {{ f.layer }}
{% endif %}
{% endmacro %}

    // ── physical / logical architecture ──
{% for p in parts %}
{{ part(p, "    ") -}}
{% endfor %}

    // ── functional architecture ──
{% for f in actions %}
{{ action_def(f) -}}
{% endfor %}
{% for f in actions %}
{{ action(f, "    ") -}}
{% endfor %}

    // ── function allocations ──
{% for a in allocations %}
    allocate {{ a.function }} to {{ a.element }};  // {{ a.layer }}
{% endfor %}

    // ── interfaces ──
{% for c in connections %}
    connection {{ c.name }} connect {{ c.source }} to {{ c.target }};  // {{ c.type }}
{% endfor %}

    // ── requirements ──
{% for r in requirements %}
    requirement def {{ r.def }};
{% endfor %}
{% for r in requirements %}
    requirement {{ r.name }} : {{ r.def }} {
        doc /* {{ r.text }} */
{% if r.subject %}
        subject subj : {{ r.subject_type }};
{% endif %}
{% if r.parent %}
        // derived from {{ r.parent }}
{% endif %}
    }
{% endfor %}

    // ── satisfaction ──
{% for s in satisfies %}
    satisfy {{ s.requirement }} by {{ s.by }};
{% endfor %}
}
